# Core Supabase configuration (required in Preview and Production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public platform configuration
NEXT_PUBLIC_PLATFORM_DOMAIN=FlexPagina.nl
NEXT_PUBLIC_MULTILINGUAL_WEBSITES=true
# Development only; do not set in Production.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# Server authorization and security (generate unique random values per environment)
ADMIN_EMAILS=
BOOKING_LINK_SECRET=
CALENDAR_SECRET_KEY=
CRON_SECRET=
ONBOARDING_ENABLED=false
PLAN_ENFORCEMENT_MODE=observe

# Transactional mail
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=FlexPagina

# Support mailbox / mail agent
MAILBOX_USER=
MAILBOX_PASSWORD=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_FROM_NAME=FlexPagina Support
MAIL_SYNC_FOLDER=INBOX
MAIL_SENT_FOLDER=Sent

# AI and lead integrations (optional until those features are enabled)
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AGENT_SUPPORT_MODEL=
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# Vercel custom-domain management (required when domain linking is enabled)
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
